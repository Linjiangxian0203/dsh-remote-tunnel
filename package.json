{
  "name": "dsh-remote-tunnel",
  "description": "Remote Host Tunnel Manager for dsh: allocate and register remote ports, run dsh web on a remote Linux server via systemd, and keep a resilient SSH tunnel from this machine to it.",
  "version": "0.1.4",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ssh",
    "tunnel",
    "remote"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linjiangxian0203/dsh-remote-tunnel.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.js",
    "./cli": "./src/cli.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "scripts",
    "docs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-cmdline": "^0.1.2-alpha.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-cmdline": "^0.1.2-alpha.3"
  },
  "scripts": {
    "test": "node --test test/unit.test.js test/integration.test.js"
  },
  "engines": {
    "node": ">=22.19"
  }
}
